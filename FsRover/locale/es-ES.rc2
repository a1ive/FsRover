// Cryptodisk unlock: passphrase (or a key file) for a LUKS/LUKS2 volume.
IDD_CRYPTO DIALOGEX 0, 0, 240, 122
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Desbloquear volumen cifrado"
FONT 9, "Segoe UI"
BEGIN
	LTEXT		"", IDC_CRYPTO_INFO, 7, 7, 226, 16
	LTEXT		"Contraseña:", IDC_STATIC, 7, 28, 60, 8
	EDITTEXT	IDC_CRYPTO_PASS, 70, 26, 163, 12, ES_PASSWORD | ES_AUTOHSCROLL
	CONTROL		"Usar un archivo de clave en su lugar", IDC_CRYPTO_USEKEYFILE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 7, 46, 160, 10
	EDITTEXT	IDC_CRYPTO_KEYFILE, 7, 60, 176, 12, ES_READONLY | ES_AUTOHSCROLL | WS_DISABLED
	PUSHBUTTON	"Examinar", IDC_CRYPTO_BROWSE, 187, 59, 46, 14, WS_DISABLED
	CONTROL		"", IDC_CRYPTO_PROGRESS, "msctls_progress32", WS_BORDER | NOT WS_VISIBLE, 7, 80, 226, 8
	DEFPUSHBUTTON	"Aceptar", IDOK, 128, 100, 50, 14
	PUSHBUTTON	"Cancelar", IDCANCEL, 183, 100, 50, 14
END

// VeraCrypt/TrueCrypt unlock.  Nothing about such a volume is plaintext, so
// besides the secret this collects the parameters it does not store.
IDD_VERACRYPT DIALOGEX 0, 0, 240, 160
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Desbloquear volumen VeraCrypt"
FONT 9, "Segoe UI"
BEGIN
	LTEXT		"", IDC_VC_INFO, 7, 7, 226, 10
	LTEXT		"Contraseña:", IDC_STATIC, 7, 24, 60, 8
	EDITTEXT	IDC_VC_PASS, 70, 22, 163, 12, ES_PASSWORD | ES_AUTOHSCROLL
	LTEXT		"Archivos de clave:", IDC_STATIC, 7, 42, 60, 8
	EDITTEXT	IDC_VC_KEYFILES, 70, 40, 79, 12, ES_READONLY | ES_AUTOHSCROLL
	PUSHBUTTON	"Añadir", IDC_VC_BROWSE, 152, 39, 40, 14
	PUSHBUTTON	"Borrar", IDC_VC_CLEARKEYS, 193, 39, 40, 14, WS_DISABLED
	LTEXT		"PIM:", IDC_STATIC, 7, 60, 60, 8
	EDITTEXT	IDC_VC_PIM, 70, 58, 38, 12, ES_NUMBER | ES_AUTOHSCROLL
	LTEXT		"Hash:", IDC_STATIC, 118, 60, 30, 8
	COMBOBOX	IDC_VC_PRF, 150, 58, 83, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
	CONTROL		"Volumen TrueCrypt", IDC_VC_TRUECRYPT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 7, 78, 226, 10
	CONTROL		"Volumen oculto", IDC_VC_HIDDEN, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 7, 91, 226, 10
	CONTROL		"Usar la cabecera de respaldo", IDC_VC_BACKUP, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 7, 104, 226, 10
	CONTROL		"", IDC_VC_PROGRESS, "msctls_progress32", WS_BORDER | NOT WS_VISIBLE, 7, 122, 226, 8
	DEFPUSHBUTTON	"Aceptar", IDOK, 128, 138, 50, 14
	PUSHBUTTON	"Cancelar", IDCANCEL, 183, 138, 50, 14
END

// Plain dm-crypt mount.  Such a volume has no header, so every parameter is
// entered here and a wrong one silently produces garbage.
IDD_PLAINMOUNT DIALOGEX 0, 0, 240, 186
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Montar volumen dm-crypt plain"
FONT 9, "Segoe UI"
BEGIN
	LTEXT		"", IDC_PM_INFO, 7, 7, 226, 10
	LTEXT		"Cifrado:", IDC_STATIC, 7, 24, 60, 8
	COMBOBOX	IDC_PM_CIPHER, 70, 22, 163, 90, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
	LTEXT		"Clave (bits):", IDC_STATIC, 7, 42, 60, 8
	COMBOBOX	IDC_PM_KEYBITS, 70, 40, 50, 90, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
	LTEXT		"Sector:", IDC_STATIC, 130, 42, 28, 8
	COMBOBOX	IDC_PM_SECTOR, 162, 40, 71, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
	LTEXT		"Hash:", IDC_STATIC, 7, 60, 60, 8
	COMBOBOX	IDC_PM_HASH, 70, 58, 163, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
	LTEXT		"Despl. (sect.):", IDC_STATIC, 7, 80, 60, 8
	EDITTEXT	IDC_PM_OFFSET, 70, 78, 50, 12, ES_NUMBER | ES_AUTOHSCROLL
	LTEXT		"Salto IV:", IDC_STATIC, 130, 80, 30, 8
	EDITTEXT	IDC_PM_SKIP, 162, 78, 71, 12, ES_NUMBER | ES_AUTOHSCROLL
	LTEXT		"Contraseña:", IDC_STATIC, 7, 98, 60, 8
	EDITTEXT	IDC_PM_PASS, 70, 96, 163, 12, ES_PASSWORD | ES_AUTOHSCROLL
	CONTROL		"Usar un archivo de clave en su lugar", IDC_PM_USEKEYFILE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 7, 114, 226, 10
	EDITTEXT	IDC_PM_KEYFILE, 7, 128, 180, 12, ES_AUTOHSCROLL | WS_DISABLED
	PUSHBUTTON	"Examinar", IDC_PM_BROWSE, 191, 127, 42, 14, WS_DISABLED
	LTEXT		"Despl. archivo:", IDC_STATIC, 7, 148, 60, 8
	EDITTEXT	IDC_PM_KEYOFFSET, 70, 146, 60, 12, ES_NUMBER | ES_AUTOHSCROLL | WS_DISABLED
	DEFPUSHBUTTON	"Aceptar", IDOK, 128, 164, 50, 14
	PUSHBUTTON	"Cancelar", IDCANCEL, 183, 164, 50, 14
END

// File properties: libmagic description on top, hash calculator below
// (layout borrowed from FileXRay's property page).
IDD_PROPS DIALOGEX 0, 0, 227, 257
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Propiedades"
FONT 9, "Segoe UI"
BEGIN
	GROUPBOX	"Archivo", IDC_STATIC, 7, 7, 213, 50
	EDITTEXT	IDC_PROPS_TYPE, 17, 20, 197, 21, ES_MULTILINE | ES_READONLY | ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
	LTEXT		"Inodo:", IDC_STATIC, 17, 44, 55, 8
	LTEXT		"", IDC_PROPS_INODE, 74, 44, 140, 8

	GROUPBOX	"Hash", IDC_STATIC, 7, 62, 213, 188
	CONTROL		"MD5", IDC_PROPS_MD5, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 17, 79, 42, 10
	CONTROL		"SHA1", IDC_PROPS_SHA1, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 82, 79, 45, 10
	CONTROL		"CRC32", IDC_PROPS_CRC32, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 147, 79, 52, 10
	CONTROL		"CRC64", IDC_PROPS_CRC64, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 17, 93, 52, 10
	CONTROL		"SHA256", IDC_PROPS_SHA256, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 82, 93, 62, 10
	CONTROL		"SHA512", IDC_PROPS_SHA512, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 147, 93, 62, 10
	CONTROL		"BLAKE2sp", IDC_PROPS_BLAKE2SP, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 17, 107, 58, 10
	CONTROL		"BLAKE3", IDC_PROPS_BLAKE3, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 82, 107, 52, 10
	PUSHBUTTON	"Calcular", IDC_PROPS_CALC, 17, 123, 60, 14
	PUSHBUTTON	"Copiar", IDC_PROPS_COPY, 154, 123, 60, 14
