	CONTROL		"", IDC_VC_PROGRESS, "msctls_progress32", WS_BORDER | NOT WS_VISIBLE, 7, 122, 226, 8
	DEFPUSHBUTTON	"確定", IDOK, 128, 138, 50, 14
	PUSHBUTTON	"取消", IDCANCEL, 183, 138, 50, 14
END

IDD_PLAINMOUNT DIALOGEX 0, 0, 240, 186
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
