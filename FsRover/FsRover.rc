// Plain dm-crypt mount.  Such a volume has no header, so every parameter is
// entered here and a wrong one silently produces garbage.
IDD_PLAINMOUNT DIALOGEX 0, 0, 240, 186
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Mount Plain dm-crypt Volume"
FONT 9, "Segoe UI"
BEGIN
	LTEXT		"", IDC_PM_INFO, 7, 7, 226, 10
	LTEXT		"Cipher:", IDC_STATIC, 7, 24, 60, 8
	COMBOBOX	IDC_PM_CIPHER, 70, 22, 163, 90, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
	LTEXT		"Key size (bits):", IDC_STATIC, 7, 42, 60, 8
	COMBOBOX	IDC_PM_KEYBITS, 70, 40, 50, 90, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
	LTEXT		"Sector:", IDC_STATIC, 130, 42, 28, 8
	COMBOBOX	IDC_PM_SECTOR, 162, 40, 71, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
	LTEXT		"Hash:", IDC_STATIC, 7, 60, 60, 8
	COMBOBOX	IDC_PM_HASH, 70, 58, 163, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
	LTEXT		"Offset (sect.):", IDC_STATIC, 7, 80, 60, 8
	EDITTEXT	IDC_PM_OFFSET, 70, 78, 50, 12, ES_NUMBER | ES_AUTOHSCROLL
	LTEXT		"IV skip:", IDC_STATIC, 130, 80, 30, 8
	EDITTEXT	IDC_PM_SKIP, 162, 78, 71, 12, ES_NUMBER | ES_AUTOHSCROLL
	LTEXT		"Passphrase:", IDC_STATIC, 7, 98, 60, 8
	EDITTEXT	IDC_PM_PASS, 70, 96, 163, 12, ES_PASSWORD | ES_AUTOHSCROLL
	CONTROL		"Use a key file instead", IDC_PM_USEKEYFILE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 7, 114, 226, 10
	EDITTEXT	IDC_PM_KEYFILE, 7, 128, 180, 12, ES_AUTOHSCROLL | WS_DISABLED
	PUSHBUTTON	"Browse", IDC_PM_BROWSE, 191, 127, 42, 14, WS_DISABLED
	LTEXT		"File offset:", IDC_STATIC, 7, 148, 60, 8
	EDITTEXT	IDC_PM_KEYOFFSET, 70, 146, 60, 12, ES_NUMBER | ES_AUTOHSCROLL | WS_DISABLED
	DEFPUSHBUTTON	"OK", IDOK, 128, 164, 50, 14
	PUSHBUTTON	"Cancel", IDCANCEL, 183, 164, 50, 14
END

// File properties: libmagic description on top, hash calculator below
// (layout borrowed from FileXRay's property page).
IDD_PROPS DIALOGEX 0, 0, 227, 203
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Properties"
FONT 9, "Segoe UI"
BEGIN
	GROUPBOX	"File", IDC_STATIC, 7, 7, 213, 50
	EDITTEXT	IDC_PROPS_TYPE, 17, 20, 197, 21, ES_MULTILINE | ES_READONLY | ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
	LTEXT		"Inode:", IDC_STATIC, 17, 44, 55, 8
	LTEXT		"", IDC_PROPS_INODE, 74, 44, 140, 8

	GROUPBOX	"Hash", IDC_STATIC, 7, 62, 213, 134
	CONTROL		"MD5", IDC_PROPS_MD5, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 17, 79, 42, 10
	CONTROL		"SHA1", IDC_PROPS_SHA1, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 82, 79, 45, 10
	CONTROL		"CRC32", IDC_PROPS_CRC32, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 147, 79, 52, 10
	CONTROL		"CRC64", IDC_PROPS_CRC64, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 17, 93, 52, 10
	CONTROL		"SHA256", IDC_PROPS_SHA256, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 82, 93, 62, 10
	CONTROL		"SHA512", IDC_PROPS_SHA512, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 147, 93, 62, 10
	PUSHBUTTON	"Calculate", IDC_PROPS_CALC, 17, 109, 60, 14
	PUSHBUTTON	"Copy", IDC_PROPS_COPY, 154, 109, 60, 14
	CONTROL		"", IDC_PROPS_PROGRESS, "msctls_progress32", WS_BORDER, 17, 129, 197, 10
	LTEXT		"Ready.", IDC_PROPS_STATUS, 17, 143, 197, 8
	EDITTEXT	IDC_PROPS_RESULT, 17, 155, 197, 34, ES_MULTILINE | ES_READONLY | ES_AUTOHSCROLL | ES_AUTOVSCROLL | WS_VSCROLL | WS_BORDER | WS_TABSTOP
END

