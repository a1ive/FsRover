// Cryptodisk unlock: passphrase (or a key file) for a LUKS/LUKS2 volume.
IDD_CRYPTO DIALOGEX 0, 0, 240, 122
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Unlock Encrypted Volume"
FONT 9, "Segoe UI"
BEGIN
	LTEXT		"", IDC_CRYPTO_INFO, 7, 7, 226, 16
	LTEXT		"Passphrase:", IDC_STATIC, 7, 28, 60, 8
	EDITTEXT	IDC_CRYPTO_PASS, 70, 26, 163, 12, ES_PASSWORD | ES_AUTOHSCROLL
	CONTROL		"Use a key file instead", IDC_CRYPTO_USEKEYFILE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 7, 46, 160, 10
	EDITTEXT	IDC_CRYPTO_KEYFILE, 7, 60, 176, 12, ES_READONLY | ES_AUTOHSCROLL | WS_DISABLED
	PUSHBUTTON	"Browse", IDC_CRYPTO_BROWSE, 187, 59, 46, 14, WS_DISABLED
	CONTROL		"", IDC_CRYPTO_PROGRESS, "msctls_progress32", WS_BORDER | NOT WS_VISIBLE, 7, 80, 226, 8
	DEFPUSHBUTTON	"OK", IDOK, 128, 100, 50, 14
	PUSHBUTTON	"Cancel", IDCANCEL, 183, 100, 50, 14
END

// VeraCrypt/TrueCrypt unlock.  Nothing about such a volume is plaintext, so
// besides the secret this collects the parameters it does not store.
IDD_VERACRYPT DIALOGEX 0, 0, 240, 160
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Unlock VeraCrypt Volume"
FONT 9, "Segoe UI"
BEGIN
	LTEXT		"", IDC_VC_INFO, 7, 7, 226, 10
	LTEXT		"Passphrase:", IDC_STATIC, 7, 24, 60, 8
	EDITTEXT	IDC_VC_PASS, 70, 22, 163, 12, ES_PASSWORD | ES_AUTOHSCROLL
	LTEXT		"Key files:", IDC_STATIC, 7, 42, 60, 8
	EDITTEXT	IDC_VC_KEYFILES, 70, 40, 105, 12, ES_READONLY | ES_AUTOHSCROLL
	PUSHBUTTON	"Add", IDC_VC_BROWSE, 178, 39, 27, 14
	PUSHBUTTON	"Clear", IDC_VC_CLEARKEYS, 206, 39, 27, 14, WS_DISABLED
	LTEXT		"PIM:", IDC_STATIC, 7, 60, 60, 8
	EDITTEXT	IDC_VC_PIM, 70, 58, 38, 12, ES_NUMBER | ES_AUTOHSCROLL
	LTEXT		"Hash:", IDC_STATIC, 118, 60, 30, 8
	COMBOBOX	IDC_VC_PRF, 150, 58, 83, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
	CONTROL		"TrueCrypt volume", IDC_VC_TRUECRYPT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 7, 78, 226, 10
	CONTROL		"Hidden volume", IDC_VC_HIDDEN, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 7, 91, 226, 10
