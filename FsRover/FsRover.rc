#pragma code_page(65001)

#include <winresrc.h>

#include "resource.h"
#include "version.h"
#include "../filetype/resource.h"

/////////////////////////////////////////////////////////////////////////////
// Language-neutral

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

// Pixel-art app icon: Mars rover driving on a hard-disk platter
// (16/32 hand-drawn masters, 48/64/128/256 nearest-neighbor scaled).
IDI_APP ICON "FsRover.ico"

// Compiled magic.mgc (zstd -19); inflated at runtime by filetype.lib
// with the zstd decoder from grub.lib.  See filetype\magic\.
IDR_FILETYPE_MAGIC_ZST RCDATA "../filetype/magic/magic.zst"

// The help page, shipped as UTF-8 markdown and rendered by the markdown
// viewer (Help > Help Document).  Language-neutral: one English page,
// not part of the string table.
IDR_HELP_MD RCDATA "help.md"

// Bundled Dokan runtime for the build architecture: user-mode library
// (dokan2.dll) and Microsoft-signed kernel driver (dokan2.sys).  Dokan >
// Install Dokan writes both to the system, creates the Dokan2 service and
// starts it.  Only the matching architecture is bundled (WoW64 is out of
// scope); the arch macro comes from the vcxproj ResourceCompile
// preprocessor definitions.
#if defined(ROVER_ARCH_X64)
IDR_DOKAN_DLL RCDATA "dokan/prebuilt/x64/dokan2.dll"
IDR_DOKAN_SYS RCDATA "dokan/prebuilt/x64/dokan2.sys"
#elif defined(ROVER_ARCH_ARM64)
IDR_DOKAN_DLL RCDATA "dokan/prebuilt/ARM64/dokan2.dll"
IDR_DOKAN_SYS RCDATA "dokan/prebuilt/ARM64/dokan2.sys"
#elif defined(ROVER_ARCH_X86)
IDR_DOKAN_DLL RCDATA "dokan/prebuilt/x86/dokan2.dll"
IDR_DOKAN_SYS RCDATA "dokan/prebuilt/x86/dokan2.sys"
#endif

// Hex viewer: a 64-bit offset bar above one virtual list view.  All
// translatable text is replaced from the string table at runtime, so a
// single language-neutral template serves every UI language.
IDD_HEX DIALOGEX 0, 0, 400, 240
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MAXIMIZEBOX
CAPTION "Hex view"
FONT 9, "Segoe UI"
BEGIN
	LTEXT		"", IDC_HEX_OFFSET_LABEL, 4, 5, 42, 10
	EDITTEXT	IDC_HEX_OFFSET_EDIT, 48, 2, 110, 14, ES_AUTOHSCROLL
	DEFPUSHBUTTON	"Go", IDC_HEX_GO, 161, 2, 34, 14
	PUSHBUTTON	"<", IDC_HEX_PREV, 198, 2, 24, 14
	PUSHBUTTON	">", IDC_HEX_NEXT, 225, 2, 24, 14
	CONTROL	"", IDC_HEX_LIST, "SysListView32", LVS_REPORT | LVS_OWNERDATA | LVS_SHOWSELALWAYS | WS_TABSTOP, 0, 20, 400, 220, WS_EX_CLIENTEDGE
END

// Text viewer: encoding/wrap/line-number/font bar above a read-only
// RichEdit (Msftedit.dll is loaded before the dialog is created).  All
// translatable text is replaced from the string table at runtime, so a
// single language-neutral template serves every UI language.
IDD_TEXT DIALOGEX 0, 0, 480, 300
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MAXIMIZEBOX
CAPTION "Text view"
FONT 9, "Segoe UI"
BEGIN
	LTEXT		"", IDC_TEXT_ENC_LABEL, 4, 5, 44, 10
	COMBOBOX	IDC_TEXT_ENCODING, 50, 3, 70, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
	CONTROL		"", IDC_TEXT_WRAP, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 124, 4, 60, 12
	CONTROL		"", IDC_TEXT_LINENUM, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 188, 4, 60, 12
	PUSHBUTTON	"", IDC_TEXT_FONT, 252, 2, 40, 14
	LTEXT		"", IDC_TEXT_INFO, 296, 5, 180, 10, SS_ENDELLIPSIS
	CONTROL		"", IDC_TEXT_EDIT, "RICHEDIT50W", ES_MULTILINE | ES_READONLY | ES_NOHIDESEL | ES_AUTOHSCROLL | ES_AUTOVSCROLL | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP, 0, 20, 480, 280, WS_EX_CLIENTEDGE
END

// Markdown preview: one read-only RichEdit filling the client area
// (Msftedit.dll is loaded before the dialog is created).  The document
// arrives as RTF through EM_STREAMIN and the caption is set at runtime,
// so a single language-neutral template serves every UI language.
IDD_MD DIALOGEX 0, 0, 480, 320
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MAXIMIZEBOX
CAPTION "Markdown preview"
FONT 9, "Segoe UI"
BEGIN
	CONTROL		"", IDC_MD_EDIT, "RICHEDIT50W", ES_MULTILINE | ES_READONLY | ES_NOHIDESEL | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP, 0, 0, 480, 320
END

// Image viewer: no controls, the whole client area is rendered with
// Direct2D (d2d1.dll is loaded at runtime).  All text lives in the
// caption, so a single language-neutral template serves every UI
// language.
IDD_IMAGE DIALOGEX 0, 0, 480, 300
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MAXIMIZEBOX
CAPTION "Image view"
FONT 9, "Segoe UI"
BEGIN
END

// About box: app icon, version, project link, copyright, third-party
// credits.  The caption and credits label come from the string table at
// runtime; the link, copyright and credits list are ASCII and
// language-neutral.  The link is a SysLink, so comctl32 v6 and
// ICC_LINK_CLASS (main.cpp) are what make it a control rather than
// literal markup.
IDD_ABOUT DIALOGEX 0, 0, 280, 202
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About"
FONT 9, "Segoe UI"
BEGIN
	CONTROL		"", IDC_ABOUT_ICON, "Static", SS_ICON | SS_NOTIFY, 12, 12, 21, 20
	LTEXT		"", IDC_ABOUT_NAME, 44, 12, 229, 10
	CONTROL		"<a href=""https://github.com/a1ive/FsRover"">https://github.com/a1ive/FsRover</a>", IDC_ABOUT_URL, "SysLink", WS_TABSTOP, 44, 24, 229, 10
	LTEXT		ROVER_COPYRIGHT, IDC_STATIC, 44, 36, 229, 10
	LTEXT		"Licensed under the GNU General Public License v3.", IDC_STATIC, 44, 48, 229, 10
	LTEXT		"", IDC_ABOUT_CREDITS_LABEL, 12, 66, 261, 10
	EDITTEXT	IDC_ABOUT_CREDITS, 12, 78, 261, 98, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
	DEFPUSHBUTTON	"OK", IDOK, 223, 181, 50, 14
END

// About-box easter egg.  The client is a nearest-neighbour scaled
// 320x180 software framebuffer; all visible game text is pixel-rendered.
IDD_GAME DIALOGEX 0, 0, 480, 270
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MAXIMIZEBOX
CAPTION "FsRover : Mars Runner"
FONT 9, "Segoe UI"
BEGIN
END

// Supported features: per-category name lists, filled at runtime from
// the grub registration lists (backend_get_support).
IDD_SUPPORT DIALOGEX 0, 0, 320, 250
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Supported features"
FONT 9, "Segoe UI"
BEGIN
	EDITTEXT	IDC_SUPPORT_TEXT, 7, 7, 306, 214, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
	DEFPUSHBUTTON	"OK", IDOK, 263, 229, 50, 14
END

// Dokan mount options: drive-letter picker plus an open-in-Explorer
// switch.  All translatable text is replaced from the string table at
// runtime, so a single language-neutral template serves every UI
// language.
IDD_DOKANMOUNT DIALOGEX 0, 0, 220, 91
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Mount to drive letter"
FONT 9, "Segoe UI"
BEGIN
	LTEXT		"", IDC_DOKAN_INFO, 7, 7, 206, 10
	LTEXT		"", IDC_DOKAN_LETTER_LABEL, 7, 25, 60, 8
	COMBOBOX	IDC_DOKAN_LETTER, 70, 23, 50, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
	CONTROL		"", IDC_DOKAN_EXPLORER, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 7, 43, 206, 10
	DEFPUSHBUTTON	"OK", IDOK, 108, 70, 50, 14
	PUSHBUTTON	"Cancel", IDCANCEL, 163, 70, 50, 14
END

// Disk/partition properties: only the two buttons live in the template.
// The sheet above them -- device icon and spec, the "field: value" rows
// (type, size, filesystem, label, UUID, start LBA, sector size, backing
// file or member devices) and the partition map -- is painted by the
// dialog, which resizes itself to that content and repositions the
// buttons in WM_INITDIALOG.  The width here is the one it keeps.
IDD_DISKPROPS DIALOGEX 0, 0, 320, 240
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Properties"
FONT 9, "Segoe UI"
BEGIN
	PUSHBUTTON	"Copy", IDC_DISKPROPS_COPY, 203, 219, 50, 14
	DEFPUSHBUTTON	"OK", IDOK, 263, 219, 50, 14
END

// Disk S.M.A.R.T.: only the header controls and the attribute list live
// in the template.  The sheet between them -- model and capacity, the
// health and temperature boxes, and the two columns of "field: value"
// rows -- is painted by the dialog, which measures that content in
// WM_INITDIALOG and sizes itself around it; the list then follows the
// frame.  All translatable text is replaced from the string table at
// runtime, so a single language-neutral template serves every UI
// language.
IDD_SMART DIALOGEX 0, 0, 360, 300
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MAXIMIZEBOX
CAPTION "S.M.A.R.T."
FONT 9, "Segoe UI"
BEGIN
	PUSHBUTTON	"", IDC_SMART_REFRESH, 249, 7, 50, 14
	CONTROL		"", IDC_SMART_HEX, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 305, 9, 48, 10
	CONTROL		"", IDC_SMART_LIST, "SysListView32", LVS_REPORT | LVS_SHOWSELALWAYS | WS_TABSTOP | WS_BORDER, 7, 160, 346, 133
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION ROVER_VERSION
PRODUCTVERSION ROVER_VERSION
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS VS_FF_DEBUG
#else
FILEFLAGS 0x0L
#endif
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "000004B0"
		BEGIN
			VALUE "CompanyName", ROVER_COMPANY "\0"
			VALUE "FileDescription", ROVER_FILEDESC "\0"
			VALUE "FileVersion", ROVER_VERSION_STR "\0"
			VALUE "InternalName", ROVER_INTERNALNAME "\0"
			VALUE "LegalCopyright", ROVER_COPYRIGHT "\0"
			VALUE "OriginalFilename", ROVER_ORIGINALNAME "\0"
			VALUE "ProductName", ROVER_PRODUCT "\0"
			VALUE "ProductVersion", ROVER_VERSION_STR "\0"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x0000, 1200
	END
END

